<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_white">

    <!-- Primary Fullscreen WebView -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none" />

    <!-- Sleek Top Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:progressDrawable="@drawable/progress_bar_custom"
        android:max="100"
        android:visibility="gone" />

    <!-- Brutalist Error / Offline Overlay -->
    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_brutalist_btn_orange"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// CONNECTION NOTICE"
                    android:textColor="@color/brand_black"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_title"
                android:textColor="@color/brand_black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_error_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_message"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_brutalist_btn_orange"
                android:text="@string/btn_retry"
                android:textColor="@color/brand_black"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_offline_guide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_brutalist_btn_black"
                android:text="@string/btn_offline_guide"
                android:textColor="@color/brand_white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_change_server"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_card_white"
                android:text="@string/btn_change_server"
                android:textColor="@color/brand_black"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Native Neo-Brutalist Splash Screen Overlay -->
    <LinearLayout
        android:id="@+id/splash_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brand_orange"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/brand_black"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXAM साथी"
                android:textColor="@color/brand_orange"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXAMSAATHI.AI"
            android:textColor="@color/brand_black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Predictive PYQ Intelligence • Class 12 &amp; JEE"
            android:textColor="@color/brand_black"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_black" />
    </LinearLayout>

</RelativeLayout>
